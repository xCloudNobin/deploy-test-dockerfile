# Server. The image defaults to HOST=0.0.0.0 PORT=8080; override with -e at run time.
HOST=0.0.0.0
PORT=3000

# Persistent SQLite database file. In the container the image default is already
# /data/taskboard.sqlite (see Dockerfile) — that is the /data volume. For local
# native runs use a path outside the release checkout, e.g. ./data/taskboard.sqlite.
# The parent directory is created automatically if needed.
DATABASE_PATH=/data/taskboard.sqlite

# Optional non-sensitive release/build marker shown in the UI footer and /api/info.
# Defaults to a "local-<gitref>-<version>" value when unset.
BUILD_MARKER=

# Optional: set to 'production' for the production runtime.
NODE_ENV=production